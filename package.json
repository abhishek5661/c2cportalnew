{
  "name": "learnlytica",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "pnpm --filter @learnlytica/frontend dev",
    "build": "pnpm --filter @learnlytica/frontend build",
    "backend:dev": "pnpm --filter @learnlytica/backend dev",
    "backend:start": "pnpm --filter @learnlytica/backend start",
    "lint": "pnpm -r lint"
  }
}
